+
+.plan-box{display:flex;flex-direction:column;gap:3px;margin:12px 0;padding:10px 12px;border-radius:8px;font-size:12px;line-height:1.4}.plan-ok{background:#eef8f0;border:1px solid #b9dcc1;color:#1f5130}.plan-bad{background:#fdeeee;border:1px solid #e8b4b4;color:#7a1f1f}
